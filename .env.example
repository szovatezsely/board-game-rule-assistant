# ---------------------------------------------------------------------------
# Copy this file to `.env` before running `docker compose up --build`.
# ---------------------------------------------------------------------------

# REQUIRED. Free key, no credit card: https://console.groq.com/keys
GROQ_API_KEY=

# Port the web UI is served on (http://localhost:<APP_PORT>)
APP_PORT=8081

# Host port for the backend API (used by the frontend dev server)
BACKEND_PORT=8080

# --- Optional overrides -----------------------------------------------------

# Text model: writes the Hungarian summary and answers rule questions.
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Vision model: reads the uploaded rulebook photos.
# gpt-oss-120b is text-only and cannot accept images, so this MUST be a model
# whose input_modalities include "image". Groq retires models periodically; the
# backend checks this against GET /models on startup and warns in the UI if it
# is unusable. To list what your key can reach:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Reasoning budget for the text model: low | medium | high
GROQ_REASONING_EFFORT=low

# Reasoning budget for the vision model: none | default
# Keep "none". Transcription is mechanical copying, and with reasoning enabled
# the model can burn its whole completion budget thinking about a dense page and
# return nothing at all.
GROQ_VISION_REASONING_EFFORT=none

# Keeps model chain-of-thought out of responses: hidden | parsed | raw
# Leave as "hidden" — with anything else the vision model writes its thinking
# into the page transcripts.
GROQ_REASONING_FORMAT=hidden

# Minimum gap between two Groq calls. The free tier allows ~30 requests per
# minute for the whole account, so raise this if you see rate-limit retries.
GROQ_MIN_CALL_INTERVAL=2500ms

# Speech tempo of the offline Piper voice (Gemini sets its own pace).
# Above 1.0 is slower, which helps with dense rules text.
TTS_LENGTH_SCALE=1.06

# --- Summary writer (recommended) -------------------------------------------
# Optional. Free key at https://aistudio.google.com/apikey. When set, Gemini
# writes the summary in far better Hungarian than the Groq models, with Groq as
# the automatic fallback if Gemini is overloaded. On the free tier, Google may
# use the requests to improve its products. Pro models have no free quota.
GEMINI_API_KEY=
# Tried in order when one is overloaded.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash

# --- Narration voice ----------------------------------------------------------
# With GEMINI_API_KEY set (above), the summary is also read aloud by Gemini TTS,
# which sounds far more natural than the offline Piper voice. Piper is used when
# there is no key, and as the fallback when Gemini is overloaded or its free
# daily quota (10 recordings per day) is spent.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# One of Gemini's prebuilt voices, e.g. Kore, Puck, Charon, Aoede.
GEMINI_TTS_VOICE=Kore

# Database credentials (only used inside the compose network).
POSTGRES_DB=boardgames
POSTGRES_USER=boardgames
POSTGRES_PASSWORD=boardgames

LOG_LEVEL=INFO
